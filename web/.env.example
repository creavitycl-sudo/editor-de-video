# Vercel Blob Storage (videos subidos, audio normalizado, renders finales)
# Crear en: Vercel Dashboard -> Storage -> Create -> Blob -> conectar al proyecto
BLOB_READ_WRITE_TOKEN=

# Supabase (login + base de datos)
# Crear proyecto en supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq (transcripción rápida con Whisper en la nube)
# Crear API key en console.groq.com -> API Keys
GROQ_API_KEY=
