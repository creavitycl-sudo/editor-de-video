  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "estudio": "concurrently -k -n server,cliente \"tsx watch estudio/server/index.ts\" \"vite --config estudio/client/vite.config.ts\"",
